                <!-- Quick Sort Section -->
        <div id="quick-sort" class="algorithm">
            <h2>Quick Sort</h2>
            <p>
                Quick sort is a divide-and-conquer algorithm that selects a pivot element, 
                partitions the array around the pivot, and recursively sorts the partitions.
            </p>
            <pre><code class="language-javascript">// Quick Sort Implementation
                function quickSort(arr) {
                    if (arr.length <= 1) return arr;
                
                    const pivot = arr[arr.length - 1];
                    const left = [];
                    const right = [];
                
                    for (let i = 0; i < arr.length - 1; i++) {
                        if (arr[i] < pivot) {
                            left.push(arr[i]);
                        } else {
                            right.push(arr[i]);
                        }
                    }
                
                    return [...quickSort(left), pivot, ...quickSort(right)];
                }
